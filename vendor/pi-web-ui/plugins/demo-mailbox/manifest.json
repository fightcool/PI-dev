{
	"id": "demo-mailbox",
	"name": "示例",
	"version": "0.2.0",
	"description": "示例插件：演示 pi-web-ui 可选界面组件的服务端入口 + 客户端视图 + 双向消息",
	"settings": [
		{
			"key": "pollSec",
			"type": "number",
			"label": "轮询间隔(秒)",
			"default": 60,
			"min": 10,
			"max": 600,
			"hint": "新邮件检查间隔"
		},
		{
			"key": "notifyEnabled",
			"type": "boolean",
			"label": "新邮件通知",
			"default": true
		},
		{
			"key": "theme",
			"type": "select",
			"label": "界面主题",
			"default": "dark",
			"options": [
				"dark",
				"light"
			],
			"hint": "demo 演示 select"
		}
	]
}
