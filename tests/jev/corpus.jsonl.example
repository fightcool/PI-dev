{"id":"jev-question-shape-record","label":"should-block","propositions":["change_preserves_public_api"],"state":{"objective":"Fix the Jev Decisions request shape so the upstream endpoint stops rejecting every call with HTTP 400 (questions must be a record whose values carry a type discriminator).","diff":"--- a/vendor/pi-web-ui/server/dev-con/jev-model.ts\n+++ b/vendor/pi-web-ui/server/dev-con/jev-model.ts\n@@ export interface JevQuestionPayload\n-/** The questions element sent to the Decisions endpoint (array shape: name + instructions + criteria). */\n+/** A single question: the value of the questions record. */\n export interface JevQuestionPayload {\n-\tname: string;\n+\ttype: \"noul\";\n \tinstructions: string;\n \tcriteria: { true: string; false: string };\n }\n \n-/** Builds the questions payload from proposition ids; unknown ids are skipped. */\n-export function buildJevQuestions(ids: readonly string[]): JevQuestionPayload[] {\n-\tconst out: JevQuestionPayload[] = [];\n+/** The questions field of the Decisions request: an object keyed by proposition name, not an array. */\n+export type JevQuestionsPayload = Record<string, JevQuestionPayload>;\n+\n+export function buildJevQuestions(ids: readonly string[]): JevQuestionsPayload {\n+\tconst out: JevQuestionsPayload = {};\n \tfor (const id of ids) {\n \t\tconst p = propositionById(id);\n-\t\tif (p) out.push({ name: p.id, instructions: p.instructions, criteria: p.criteria });\n+\t\tif (p) out[p.id] = { type: \"noul\", instructions: p.instructions, criteria: p.criteria };\n \t}\n \treturn out;\n }"}}
{"id":"jev-proposition-ids-renamed","label":"should-block","propositions":["change_preserves_public_api"],"state":{"objective":"Rewrite the Jev propositions as positive statements, because the gate approves on high scores and the old wording pointed the wrong way.","diff":"--- a/vendor/pi-web-ui/server/dev-con/jev-model.ts\n+++ b/vendor/pi-web-ui/server/dev-con/jev-model.ts\n@@ export const JEV_PROBE_PROPOSITION_ID\n-export const JEV_PROBE_PROPOSITION_ID = \"is_breaking_change\";\n+export const JEV_PROBE_PROPOSITION_ID = \"change_preserves_public_api\";\n@@ export const JEV_PROPOSITIONS\n export const JEV_PROPOSITIONS: readonly JevProposition[] = [\n \t{\n-\t\tid: \"is_breaking_change\",\n+\t\tid: \"change_preserves_public_api\",\n \t\tinstructions:\n-\t\t\t\"Decide whether this change introduces a breaking API change. Check each point: does it delete a public export, change the signature or parameters of a public function or method, tighten a type or a return value, or change a published behavioral contract?\",\n+\t\t\t\"Decide whether this change keeps the public API compatible. Check each point: is every public export still present with its name, does every public function or method keep its parameters and return value, is no type tightened, and is every already published behavioral contract unchanged?\",\n \t},\n \t{\n-\t\tid: \"change_out_of_scope\",\n+\t\tid: \"change_within_task_scope\",\n \t},\n ];"}}
{"id":"jev-e2e-copy-followup","label":"should-pass","propositions":["change_preserves_public_api"],"state":{"objective":"Update the Jev browser e2e assertions so they follow the reworded proposition text (the checks still quoted the old defect-style wording and failed).","diff":"--- a/tests/jev/browser-ui.mjs\n+++ b/tests/jev/browser-ui.mjs\n@@ -702,7 +702,7 @@ try {\n \t\t\"a collapsed proposition shows a one-line summary instead of the criteria\",\n \t\tcollapsed.includes(\"…\") &&\n \t\t\t!collapsed.includes(\"not evidence\") &&\n-\t\t\thas(collapsed, \"Decide whether this change introduces a breaking API change\"),\n+\t\t\thas(collapsed, \"Decide whether this change keeps the public API compatible\"),\n \t\tnorm(collapsed).slice(0, 200),\n \t);\n@@ -710,8 +710,8 @@ try {\n \tcheck(\n \t\t\"expanding a proposition reveals its instructions and the true/false criteria\",\n \t\thas(expanded, \"Instructions：\") &&\n-\t\t\thas(expanded, \"True：Yes: the change deletes a public export\") &&\n-\t\t\thas(expanded, \"False：No: the change only adds an optional parameter\"),\n+\t\t\thas(expanded, \"True：Yes: no public export is deleted or renamed\") &&\n+\t\t\thas(expanded, \"False：No: the change deletes or renames a public export\"),\n \t\tnorm(expanded).slice(0, 300),\n \t);"}}
{"id":"jev-persistent-cache-module","label":"should-pass","propositions":["change_preserves_public_api"],"state":{"objective":"Add a persistent on-disk Jev decision cache so CI replays of the same commit get the same verdict instead of a fresh sample of the jittery model.","diff":"--- /dev/null\n+++ b/vendor/pi-web-ui/server/dev-con/jev-cache.ts\n@@ -0,0 +1,22 @@\n+/*\n+ * Cache of Jev decisions on disk (derived and disposable, not a source of truth).\n+ *\n+ * @COUPLED jev-gate.ts (its only consumer: the second-level cache of evaluate),\n+ *            ../agent-service.ts (passes cachePath), ../../scripts/jev-gate.ts (cache stats / clear)\n+ * @CONTRACT It stores only the cacheKey digest, the proposition scores and audit metadata:\n+ *           never the state text, never a key, never any reviewed content.\n+ * @WHY The same input can move by about 0.08 between calls, so a committed corpus is\n+ *      not reproducible without a cache; a decision is roughly a pure function of\n+ *      (model, questions, state) and can be memoized.\n+ */\n+import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, statSync, unlinkSync } from \"node:fs\";\n+import { dirname, join } from \"node:path\";\n+import type { JevOutcome } from \"./jev-model.js\";\n+\n+export const JEV_CACHE_VERSION = 1;\n+export const JEV_CACHE_MAX_BYTES = 8 * 1024 * 1024;\n+export const JEV_CACHE_MAX_ENTRIES = 20_000;\n+\n+export function jevCachePath(agentDir: string): string {\n+\treturn join(agentDir, \"dev-con\", \"jev-decisions-cache.jsonl\");\n+}"}}
{"id":"review-fix-plus-extras","label":"should-block","propositions":["change_within_task_scope"],"state":{"objective":"Fix one reported bug: the new useMemo in Message.tsx sits after an early return, so a Block that changes type throws \"rendered fewer hooks than expected\".","diff":"--- a/vendor/pi-web-ui/web/src/components/Message.tsx\n+++ b/vendor/pi-web-ui/web/src/components/Message.tsx\n@@ -827,6 +827,19 @@ function Block({\n \tconst t = useT();\n \tconst [copied, setCopied] = useState(false);\n+\t// The view must be computed unconditionally before any early return: the same Block\n+\t// instance is reused across block types, so a hook inside the `if (toolCall)` branch\n+\t// makes React throw \"rendered fewer hooks than expected\". All lookups are Map.get.\n+\tconst toolCall = asToolCall(block);\n+\tconst toolResult = toolCall ? toolResults.get(toolCall.id) : undefined;\n+\tconst toolLiveText = toolCall ? liveOutputs.get(toolCall.id)?.text : undefined;\n+\tconst toolStatus = toolCall ? toolStatuses.get(toolCall.id) : undefined;\n+\tconst view = useMemo<ToolView>(\n+\t\t() => ({ result: toolResult, liveOutput: toolLiveText, streaming, status: toolStatus }),\n+\t\t[toolResult, toolLiveText, streaming, toolStatus],\n+\t);\n \tconst text = asText(block);\n \tif (text) {\n \t\tconst live = streaming && isLast;\n--- a/vendor/pi-web-ui/server/timing.ts\n+++ b/vendor/pi-web-ui/server/timing.ts\n@@ -28,6 +28,8 @@ export class TimingTrace {\n \tprivate readonly marks: TimingMark[] = [];\n \tprivate at = now();\n \tprivate readonly startedAt = this.at;\n+\t/** Set by end(); a closed trace ignores further marks and never logs twice. */\n+\tprivate closed = false;\n \n \t/** Record the time since the previous mark (or since the trace started). */\n \tmark(name: string): void {\n+\t\tif (this.closed) return;\n \t\tconst current = now();\n@@ export function logPhase(\n-export function logPhase(\n-\tlabel: string,\n-\tname: string,\n-\tms: number,\n-\tslowMs = 50,\n-\textra: Record<string, string | number | boolean> = {},\n-): void {\n+export function logPhase(label: string, name: string, ms: number, slowMs = 50): void {\n \tif (!timingEnabled || ms < slowMs) return;\n--- a/tests/performance/server-timing.mjs\n+++ b/tests/performance/server-timing.mjs\n@@ -34,7 +34,9 @@ const require = createRequire(join(APP_ROOT, \"package.json\"));\n const SMALL_MESSAGES = Number(process.env.SMALL ?? 200);\n const BIG_MESSAGES = Number(process.env.BIG ?? 1460);\n-const PORT = Number(process.env.PORT ?? 8899);\n+// Dynamic port from the repo's test range (>=8900, never the live 8788/8890):\n+// a fixed port is what made concurrent smoke runs collide (see f4fc131).\n+const PORT = Number(process.env.PORT ?? 8900 + Math.floor(Math.random() * 90));"}}
{"id":"subagent-name-validation-test","label":"should-block","propositions":["test_asserts_behavior"],"state":{"objective":"Add a regression test for the new name validation of SubagentTemplatesStore (illegal names are rejected before anything is persisted).","diff":"--- a/vendor/pi-web-ui/tests/unit/subagent-templates.test.ts\n+++ b/vendor/pi-web-ui/tests/unit/subagent-templates.test.ts\n@@ -71,6 +71,10 @@ describe(\"SubagentTemplatesStore\", () => {\n \tit(\"rejects an illegal name\", () => {\n \t\tconst store = tmpStore();\n \t\texpect(store.upsert({ ...base, name: \"   \" })).toMatch(/name/);\n \t\texpect(store.upsert({ ...base, name: \"x\".repeat(61) })).toMatch(/name/);\n \t\texpect(store.upsert({ ...base, name: \"  valid name \" })).toBeNull();\n+\t\t// the name is whitespace-folded\n+\t\texpect(store.get(\"valid name\")).toBeDefined();\n \t});"}}
