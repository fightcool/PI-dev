{
  "name": "pi-dev-environment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible, isolated Pi development workstation for Linux x86_64",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "setup:dependencies": "node scripts/dependencies.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm --prefix vendor/pi-web-ui run typecheck",
    "test:unit": "npm --prefix vendor/pi-web-ui test",
    "test:performance": "node tests/performance/browser.mjs",
    "test:smoke": "node scripts/protocol-smoke.mjs",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:public": "node scripts/public-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "diagnostics:usage": "node scripts/diagnostics/analyze-usage.mjs",
    "release:check": "node scripts/release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@howaboua/pi-codex-conversion": "3.0.31",
    "@narumitw/pi-goal": "0.54.4",
    "pi-context-prune": "1.4.0",
    "pi-lens": "4.1.5",
    "pi-mcp-adapter": "2.32.1",
    "pi-subagents": "0.66.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "qs": "6.16.0"
  }
}
